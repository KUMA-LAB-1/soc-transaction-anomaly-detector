# Copie este arquivo para .env na raiz do projeto.
#
# As URLs abaixo devem utilizar identidades PostgreSQL de LOGIN com apenas
# as permissões necessárias para cada responsabilidade.

# Runtime principal do pipeline SOC.
# O usuário PostgreSQL deve possuir a role/capability soc_pipeline.
SOC_DATABASE_URL=postgresql://soc_runtime_user:SENHA@HOST:6543/postgres?sslmode=require

# Ingestão do MITRE ATT&CK.
# O usuário PostgreSQL deve possuir a role/capability threat_intel_writer.
MITRE_DATABASE_URL=postgresql://mitre_ingest_user:SENHA@HOST:6543/postgres?sslmode=require

# Identidade lógica registrada nos eventos de auditoria.
SOC_PIPELINE_USER=soc-pipeline-local

# Alert persistence
ALERT_STORAGE=none
ALERT_JSONL_PATH=reports/alerts/alerts.jsonl
